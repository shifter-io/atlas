# Public launch settings only. Source this file from the framework checkout.
# Choose a future whole UTC hour and copy the SAME generated campaign.json to all eight servers.
ONBOARDING_START_UTC=2027-01-01T22:00:00Z
ONBOARDING_PROVIDER_CONFIG=configs/shifter.toml
ONBOARDING_PRODUCT=residential
ONBOARDING_REGION=fra1
ONBOARDING_CONCURRENCY=1000
ONBOARDING_TIMEOUT=10
# Set ONBOARDING_MANIFEST to the path printed by `onboarding plan`.
# Credentials belong in .secrets/credentials.toml; never put them in this file.
