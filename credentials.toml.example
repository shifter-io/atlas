# Copy to .secrets/credentials.toml, then replace the placeholders locally.
# chmod 700 .secrets && chmod 600 .secrets/credentials.toml
# Never commit the private copy. Pass --credentials-file .secrets/credentials.toml.
# Each provider has its own table; adapters define its required credential fields.
# Account is the base login without targeting flags; password without flag suffixes.

[byteful]
account = "YOUR_BASE_ACCOUNT_ID"
password = "YOUR_PROXY_PASSWORD"

[dataimpulse]
account = "YOUR_BASE_ACCOUNT_ID"
password = "YOUR_PROXY_PASSWORD"

