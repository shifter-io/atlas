# Atlas's Caddy, shared by both environments; written by scripts/server-setup.sh.
# Each environment's site is its own file in sites/, so writing one never changes the other.
# The sites answer any host name and address with one internal certificate (atlas-origin).
{
	admin unix/@CADDY@/admin.sock
	default_sni atlas-origin
	fallback_sni atlas-origin
	skip_install_trust
	auto_https disable_redirects
}

import sites/*.caddy
