# Atlas @ENV@: the CDN's origin; written by scripts/server-setup.sh (serving colour: @COLOUR@).
# Two listeners share one log and the request limits. The CDN fetches from the plain HTTP one
# (@HTTP_PORT@, ORIGIN-HTTP-1), which forwards every request: no header to check, no redirect.
# The HTTPS one (@SITE_PORT@) forwards only requests carrying the secret header and answers every
# other request an empty 403. The access log never holds the secret header (its filter deletes it).
(atlas-@ENV@-origin) {
	log {
		output file @CADDY@/logs/@ENV@-access.log {
			mode 600
			roll_size 50MiB
			roll_keep 10
		}
		format filter {
			wrap json
			request>headers>X-Atlas-Origin-Key delete
		}
	}
	request_body {
		max_size 1MB
	}
}

https://atlas-origin:@SITE_PORT@, https://:@SITE_PORT@ {
	tls internal
	import atlas-@ENV@-origin
	@cdn header X-Atlas-Origin-Key @KEY@
	handle @cdn {
		header Strict-Transport-Security "max-age=31536000"
		reverse_proxy 127.0.0.1:@UPSTREAM@
	}
	respond 403
}

# No redirect to HTTPS (the global auto_https disable_redirects) and no Strict-Transport-Security,
# which means nothing on a plain HTTP answer.
http://:@HTTP_PORT@ {
	import atlas-@ENV@-origin
	reverse_proxy 127.0.0.1:@UPSTREAM@
}
