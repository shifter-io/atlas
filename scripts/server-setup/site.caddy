# Atlas @ENV@: the CDN's origin; written by scripts/server-setup.sh.
# Two listeners share one log and the request limits. The CDN fetches from the plain HTTP one
# (@HTTP_PORT@, ORIGIN-HTTP-1), which forwards every request: no header to check, no redirect.
# The HTTPS one (@SITE_PORT@) forwards only requests carrying the secret header and answers every
# other request an empty 403. The access log never holds the secret header (its filter deletes it).
# Both name the visitor to the API in X-Atlas-Client-Ip (SEC-RATE-1): `unknown` (no per-visitor
# budget, whatever the request sent) until atlas-cdn-edges has written the CDN's edge servers and
# edges/client-header.caddy, whose header_up comes later and wins.
# Both listeners forward to both colours (DEPLOY-SEAMLESS-1): a deploy never rewrites this file
# or reloads Caddy, whose reload closes the CDN's idle connections and dropped a fetch (#1273).
# Blue first, green while blue is down: a stopped or starting colour (503) fails the health check,
# and a refused or broken GET is tried again on the other colour, so stopping one drops nothing.
(atlas-@ENV@-colours) {
	reverse_proxy 127.0.0.1:@BLUE_PORT@ 127.0.0.1:@GREEN_PORT@ {
		lb_policy first
		lb_try_duration 10s
		lb_try_interval 250ms
		lb_retry_match {
			method GET HEAD
		}
		fail_duration 5s
		health_uri /healthz
		health_interval 2s
		health_timeout 2s
		health_passes 5
		health_fails 1
		header_up X-Atlas-Client-Ip unknown
		import @CADDY@/edges/client-header*.caddy
	}
}

(atlas-@ENV@-origin) {
	log {
		output file @CADDY@/logs/@ENV@-access.log {
			mode 600
			roll_size 50MiB
			roll_keep 10
		}
		format filter {
			wrap json
			request>headers>X-Atlas-Origin-Key delete
		}
	}
	request_body {
		max_size 1MB
	}
}

https://atlas-origin:@SITE_PORT@, https://:@SITE_PORT@ {
	tls internal
	import atlas-@ENV@-origin
	@cdn header X-Atlas-Origin-Key @KEY@
	handle @cdn {
		header Strict-Transport-Security "max-age=31536000"
		import atlas-@ENV@-colours
	}
	respond 403
}

# No redirect to HTTPS (the global auto_https disable_redirects) and no Strict-Transport-Security,
# which means nothing on a plain HTTP answer.
http://:@HTTP_PORT@ {
	import atlas-@ENV@-origin
	import atlas-@ENV@-colours
}
