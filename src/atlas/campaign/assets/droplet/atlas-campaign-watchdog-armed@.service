# CAMP-1: missed-hour alarm for campaign %i (check "armed"): it alerts, and starts the tick only while its timer is enabled.
[Unit]
Description=Atlas campaign %i: watchdog (armed)

[Service]
Type=oneshot
ExecStart=/opt/atlas-campaign/venv/bin/atlas campaign watchdog --root /opt/atlas-campaign/campaigns/%i --check armed
WorkingDirectory=/opt/atlas-campaign
UMask=0077
