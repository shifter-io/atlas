# MANAGER-ORCH-1: ANALYZE the partitioned parents (DB-CHECK-1); one JSON health line in the journal.
[Unit]
Description=Atlas database: nightly ANALYZE of the partitioned parents
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/atlas-campaign/venv/bin/atlas db-server analyze --database-file /etc/atlas/database.toml
WorkingDirectory=/opt/atlas-campaign
UMask=0077
