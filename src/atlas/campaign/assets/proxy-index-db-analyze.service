# MANAGER-ORCH-1: ANALYZE the partitioned parents (DB-CHECK-1); one JSON health line in the journal.
[Unit]
Description=Atlas database: nightly ANALYZE of the partitioned parents
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/proxy-index-campaign/venv/bin/atlas db-server analyze --database-file /etc/proxy-index/database.toml
WorkingDirectory=/opt/proxy-index-campaign
UMask=0077
