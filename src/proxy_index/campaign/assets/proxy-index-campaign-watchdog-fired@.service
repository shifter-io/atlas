# CAMP-1: missed-hour alarm for campaign %i (check "fired"): it alerts, and starts the tick only while its timer is enabled.
[Unit]
Description=Proxy Index campaign %i: watchdog (fired)

[Service]
Type=oneshot
ExecStart=/opt/proxy-index-campaign/venv/bin/proxy-index campaign watchdog --root /opt/proxy-index-campaign/campaigns/%i --check fired
WorkingDirectory=/opt/proxy-index-campaign
UMask=0077
