# MANAGER-ORCH-1: starts the next hour's daily test as its own transient unit
# proxy-index-daily-YYYYMMDDTHH, so a slow hour (up to its slot plus 30 minutes) never blocks the
# next one, and an hour is never started twice. Inputs are the manager's own fixed files:
# the formulas and the template link that orchestrator-enable installs and checks.
[Unit]
Description=Proxy Index daily test: start the next hour's run and ingest

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'exec systemd-run --no-block --unit=proxy-index-daily-$$(date -u -d "+10 min" +%%Y%%m%%dT%%H) --property=UMask=0077 --property=TimeoutStopSec=20min --property=WorkingDirectory=/opt/proxy-index-campaign /opt/proxy-index-campaign/venv/bin/proxy-index daily hour --formulas /opt/proxy-index-campaign/daily/formulas --template /opt/proxy-index-campaign/daily/template --database-file /etc/proxy-index/database.toml --mmdb /opt/proxy-index-campaign/db-ip/dbip-full.mmdb --start next-hour'
